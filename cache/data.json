{

    "mayapy": {

        "commands": {

            "id":"commands",
            "startup_code":{

            "1":"import maya.standalone",
            "2":"maya.standalone.initialize( name = 'python' )",
            "3":"import maya.cmds as cmds",
            "4":"import maya.mel as mel"

            },
            "main_code": { 

                
                "get_items":{
                    "format":"f",
                    "return":true,
                    "command":"'cmds.ls( objectsOnly = True, assemblies = True, dag = True, exactType = [ 'camera', 'transform', 'joint' ])'"
                },
                "open_file":{
                    "format": "file",
                    "return": false,
                    "command": "cmds.file( {}, open = True )"
                },
                "get_hierarchy":{
                    "format": "object",
                    "return": true,
                    "command": "cmds.listRelatives( {}, allDescendents = True )"
                },
                "get_keyframes":{
                    "format": "object",
                    "return": true,
                    "command": "sorted( cmds.keyframe( {}, q=True ))"
                },
                "animation_bake":{
                    "format": "object",
                    "return" : false,
                    "command": "cmds.bakeSimulation( {}, animation = 'keysOrObjects', hierarchy = 'below' )"
                },
                "export_fbx":{
                    
                    "export":{
                        "format":"objects",
                        "command":"mel.eval(‘FBXExport -f {} -s’)"
                    },
                    "settings":{

                        "reset_settings":"mel.eval( 'FBXResetExport' )",
                        "animation_bake":"mel.eval( 'FBXExportBakeComplexAnimation -value {} )",
                        "bake_start":"mel.eval( 'FBXExportBakeComplexStart -value {}' )",
                        "bake_end":"mel.eval( 'FBXExportBakeComplexEnd -value {}' )",
                        "include_animation":"mel.eval( 'FBXExportAnimationOnly -value {}' )"
                    }
                
                },
                "get_timeline":{
                    "get_start":{
                        "return":true,
                        "command":"cmds.playbackOptions( query = True, animationStartTime = True )"
                    },
                    "get_end":{
                        "return":true,
                        "command":"cmds.playbackOptions( query = True, animationEndTime = True )"
                    },
                    "get_min":{
                        "return":true,
                        "command":"cmds.playbackOptions( query = True, minTime = True )"
                    },
                    "get_max":{
                        "return":true,
                        "command":"cmds.playbackOptions( query = True, maxTime = True )"
                    }
                }
            
            }
        
        }
    
    },

    "data": {

        "paths": {
            "1":null
        },
        
        "instances": {

            "mayapy":[
                
            ]
        },
        
        "from_maya": {

            "instance": {
                "example-instance": {
                    "address":"classaddress",
                    "return_data":{
                        
                        "get_items": [
                            
                            "item1", 
                            "item2"
                        ]
                    }
                }
            }
        }
    },

    "ui": {

        "id": "identifier",
        "parent": {
            
            "id": "var",    
            "self.menu_bar": {
                
                "id": "identifier",
                "parent2": {

                    "id": "var",
                    "self.menu_debug": {
                        
                        "id":"identifier",
                        "parent2_action": { 

                            "id": "function",
                            "addAction": {
                                
                                "id":"identifier",
                                "var_result":{

                                    "id":"var",
                                    "self.someaction": {
                                        
                                        "id":"constructor",
                                        "QAction": {
                                            
                                            "id":"identifier",
                                            "instance_methods":{

                                            "id":"function",
                                            "setText": "someaction",
                                            "connect": {

                                                "id":"connect_identifier",
                                                "type": "triggered",
                                                "perameters": {

                                                    "id": "identifier",
                                                    "expression": "lambda",
                                                    "function": "self.debug_output_box.write",
                                                    "arg": "'someaction'"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
