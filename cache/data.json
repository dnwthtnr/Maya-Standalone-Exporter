                "original": "class"
            }
        },
        
        "from_maya": {

            "animation": "data"
        }
    },

    "ui": {

        "id": "identifier",
        "parent": {
            
            "id": "var",    
            "self.menu_bar": {
                
                "id": "identifier",
                "parent2": {

                    "id": "var",
                    "self.menu_debug": {
                        
                        "id":"identifier",
                        "parent2_action": { 

                            "id": "function",
                            "addAction": {
                                
